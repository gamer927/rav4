// TCU enclosure for the 1999 RAV4 transmission controller.
//
// Holds, on the floor of the box:
//   * Arduino Mega 2560 + hub shield on standoffs (official hole pattern),
//     USB-B reachable through the left wall for flashing and logging
//   * the power board (90 x 150 perfboard: everything that touches the car's
//     12 V wiring: relays, drivers, current sensors, optos, 5 V supply)
//   * the logic board (90 x 70 perfboard: shifter and dash inputs, ATF probe, and the
//     MPU-6050 gyro, which lies FLAT when the box is bolted in level)
//   * eight cable glands in the front wall (round holes, not switches), one
//     per connector X1-X7 plus the dummy-load heatsink cable, each with its
//     name engraved above it. The box itself has no switches: they are all
//     on the dash pod (hardware/dash_pod.scad)
//   * mounting ears for M6 bolts, and a screw-on lid (M3 heat-set inserts)
//
// part = "fit_check" renders every board part, the Mega stack, the glands and
// the wires (each cable's cores fanned out to its terminals, both ribbon
// cables with their plugs), from board_envelopes.scad (generated by
// tools/boards.py), intersected with the box and with each other, and checks
// there's room to work between the glands and the terminals: an EMPTY result
// means everything fits.
// part = "fit" shows the populated box.
//
// The three 15 ohm dummy resistors make 14-28 W of heat. They do NOT go in
// this box: bolt them to a finned aluminium heatsink outside it (see
// hardware/README.md). The "LOAD" gland carries their four wires.
//
// Print in PETG or ASA, NOT PLA: behind the glovebox of a car parked in the
// sun gets hotter than PLA's ~55 C softening point. Measure your boards and
// glands and adjust the sizes below before printing.
//
// Render one part at a time:  part = "box";  or  part = "lid";
part = "box";  // [box, lid, assembly, fit, fit_check]

include <board_envelopes.scad>

/* [Box] */
IW = 210;          // inside width  (x)
ID = 186;          // inside depth  (y)
IH = 45;           // inside height (z)
wall = 3;
floor_t = 3;
lid_t = 3;
corner_r = 4;

/* [Arduino Mega 2560] */
mega_pos = [7.5, ID - 6 - 53.3];   // board origin (USB/DC-jack corner)
mega_holes = [[13.97, 2.54], [15.24, 50.8], [66.04, 7.62],
              [66.04, 35.56], [90.17, 50.8], [96.52, 2.54]];
mega_standoff_h = 6;
usb_center_y = 38.1;               // USB-B centre along the board edge
usb_cut = [18, 15];                // wall cut-out: the USB-B plug's moulding must pass the wall

/* [Perfboards] */
// 30 mm back from the front wall: the glands poke ~10 mm inside, which
// leaves ~20 mm to fan each cable's wires out and screw them into the
// terminals by hand.
power_pos = [IW - 6 - 90, 30];
logic_pos = [8, 30];
pb_hole_inset = 3;                 // corner mounting holes; measure your boards
pb_standoff_h = 6;

/* [Standoffs] */
standoff_d = 7;
standoff_hole = 2.6;               // self-tapping M3 / pilot for M2.5 screw
insert_d = 4.2;                    // M3 heat-set insert
insert_depth = 8;
boss_d = 16;                       // corner bosses, centred on the inside corners
boss_off = 2.5;                    // insert offset from the inside corner (x and y)
lid_screw_clear = 3.4;

/* [Cable glands (front wall)] */
// [label, hole diameter]: PG9 = 15.2 mm, PG7 = 12.5 mm
// [label, hole diameter, x from the box's outer left edge]
// Left to right they match the terminal groups on the boards behind them.
glands = [["SHIFT", 12.5, 21], ["DASH", 12.5, 44.5], ["SCREEN", 12.5, 68], ["ATF", 12.5, 91.5],
          ["SIG", 15.2, 120], ["PWR", 15.2, 144], ["SOL", 15.2, 168], ["LOAD", 15.2, 192]];
gland_z = 20;                      // centre height above the floor top
gland_nut = [[12.5, 17.5], [15.2, 22.5]];   // [hole, locknut across corners]
// Where each gland's wires go: [gland, board, terminal group, waypoint]. The
// SIG wires run back along the channel between the two boards to J3 on the
// power board's left edge; the rest go straight back to the front row.
gland_wires = [["SHIFT", "logic", "X7"], ["DASH", "logic", "X4"], ["SCREEN", "logic", "X5"],
               ["ATF", "logic", "X6"], ["SIG", "power", "J3", [106, 34]], ["PWR", "power", "J1"],
               ["SOL", "power", "J2"], ["LOAD", "power", "J4"]];
bundle_d = 8;                      // a cable's cores, fanned out: modelled as an 8 mm bundle
ribbon_plug_h = 9;                 // IDC plug on top of a box header
ribbon_len = 100;                  // both ribbons: about 10 cm, plug to plug

/* [Mounting] */
// Ears make the box 244 mm wide: needs a 250 mm bed. For a 220 x 220 bed set
// ears = false; the box is then 216 mm wide and bolts down through four M5
// holes in the floor, placed clear of the boards.
ears = true;
floor_holes = [[20, 113], [96, 113], [130, 7], [196, 7]];  // inside coordinates
floor_hole_d = 5.5;
ear_len = 14;
ear_slot = [14, 6.6];              // M6 slots
ear_t = 5;

/* [Vents] */
vents = true;

$fn = 48;
OW = IW + 2 * wall;
OD = ID + 2 * wall;
OH = floor_t + IH;

module rbox(size, r) {
    hull() for (x = [r, size[0] - r], y = [r, size[1] - r])
        translate([x, y, 0]) cylinder(h = size[2], r = r);
}

// inside coordinates -> outside
module inside() { translate([wall, wall, floor_t]) children(); }

corner_boss = [[0, 0], [IW, 0], [0, ID], [IW, ID]];

module standoff(h, hole = standoff_hole) {
    difference() {
        cylinder(h = h, d = standoff_d);
        translate([0, 0, 1]) cylinder(h = h, d = hole);
    }
}

module box(with_standoffs = true) {
    difference() {
        union() {
            difference() {
                rbox([OW, OD, OH], corner_r);
                inside() rbox([IW, ID, IH + 1], max(corner_r - wall, 0.5));
            }
            // corner bosses for the lid screws (fused into both walls)
            intersection() {
                rbox([OW, OD, OH], corner_r);
                inside() for (c = corner_boss)
                    translate([c[0], c[1], 0]) cylinder(h = IH, d = boss_d);
            }
            // mounting ears on the short sides
            if (ears) for (x = [-ear_len, OW]) translate([x, OD / 2 - 15, 0]) difference() {
                hull() {
                    cube([ear_len, 30, ear_t]);
                    translate([x < 0 ? ear_len - 1 : 0, 0, 0]) cube([1, 30, ear_t + 8]);
                }
                translate([ear_len / 2, 15, -1]) hull() for (dy = [-1, 1] * (ear_slot[0] - ear_slot[1]) / 2)
                    translate([0, dy, 0]) cylinder(h = ear_t + 2, d = ear_slot[1]);
            }
            if (with_standoffs) inside() {
                for (h = mega_holes)
                    translate([mega_pos[0] + h[0], mega_pos[1] + h[1], 0]) standoff(mega_standoff_h);
                for (b = [[power_pos, power_board_size], [logic_pos, logic_board_size]])
                    for (x = [pb_hole_inset, b[1][0] - pb_hole_inset], y = [pb_hole_inset, b[1][1] - pb_hole_inset])
                        translate([b[0][0] + x, b[0][1] + y, 0]) standoff(pb_standoff_h);
            }
        }
        if (!ears) inside() for (h = floor_holes)
            translate([h[0], h[1], -floor_t - 1]) cylinder(h = floor_t + 2, d = floor_hole_d);
        // corner bosses: heat-set insert holes from the top
        inside() for (c = corner_boss)
            translate([c[0] + (c[0] == 0 ? boss_off : -boss_off), c[1] + (c[1] == 0 ? boss_off : -boss_off), IH - insert_depth])
                cylinder(h = insert_depth + 1, d = insert_d);
        // USB-B access, left wall
        translate([-1, wall + mega_pos[1] + usb_center_y - usb_cut[0] / 2,
                   floor_t + mega_standoff_h + 1.6 + 5.5 - usb_cut[1] / 2])
            cube([wall + 2, usb_cut[0], usb_cut[1]]);
        // glands and their labels, front wall
        for (g = glands) {
            translate([g[2], wall + 1, floor_t + gland_z]) rotate([90, 0, 0])
                cylinder(h = wall + 2, d = g[1]);
            translate([g[2], 0.6, floor_t + gland_z + 14]) rotate([90, 0, 0])
                linear_extrude(1) text(g[0], size = 4, halign = "center",
                                       font = "DejaVu Sans:style=Bold");
        }
        // vent slots high on the right wall (the relays and buck are the warm parts)
        if (vents) for (y = [OD / 2 - 40 : 8 : OD / 2 + 40])
            translate([OW - wall - 1, y - 1.5, OH - 18]) cube([wall + 2, 3, 12]);
        // board names on the floor, so each board goes in the right place
        inside() for (t = [[power_pos, power_board_size, "POWER BOARD"], [logic_pos, logic_board_size, "LOGIC BOARD"],
                           [mega_pos, [101.6, 53.3], "MEGA (USB TO THE LEFT)"]])
            translate([t[0][0] + t[1][0] / 2, t[0][1] + t[1][1] / 2, -0.6])
                linear_extrude(1) text(t[2], size = 5, halign = "center", valign = "center",
                                       font = "DejaVu Sans:style=Bold");
    }
}

module lid() {
    difference() {
        union() {
            rbox([OW, OD, lid_t], corner_r);
            // locating lip that drops inside the walls
            translate([wall + 0.4, wall + 0.4, -2])
                difference() {
                    rbox([IW - 0.8, ID - 0.8, 2], max(corner_r - wall, 0.5));
                    translate([2, 2, -1]) rbox([IW - 4.8, ID - 4.8, 4], 0.5);
                }
        }
        for (c = corner_boss)
            translate([wall + c[0] + (c[0] == 0 ? boss_off : -boss_off), wall + c[1] + (c[1] == 0 ? boss_off : -boss_off), -3]) {
                cylinder(h = lid_t + 4, d = lid_screw_clear);
                translate([0, 0, 3 + lid_t - 1.8]) cylinder(h = 2, d1 = lid_screw_clear, d2 = 6.5);
            }
        // notches in the lip clear the corner bosses
        for (c = corner_boss)
            translate([wall + c[0], wall + c[1], -3]) cylinder(h = 3, d = boss_d + 1);
        translate([OW / 2, OD / 2, lid_t - 0.6]) linear_extrude(1)
            text("RAV4 TCU", size = 10, halign = "center", valign = "center",
                 font = "DejaVu Sans:style=Bold");
        translate([OW / 2, OD / 2 - 14, lid_t - 0.6]) linear_extrude(1)
            text("RELAYS OFF = FACTORY ECU", size = 4.5, halign = "center", valign = "center",
                 font = "DejaVu Sans:style=Bold");
    }
}

// ------------------------------------------------------------ fit check
// Everything that goes inside, as solid blocks: each board part at its real
// height, 3 mm under each board for solder joints and wires, the Mega with
// its hub shield, plugged ribbon headers and USB jack, and each gland's
// locknut plus cable entry.
module board_contents(pos, size, parts) {
    z0 = pb_standoff_h;
    translate([pos[0], pos[1], 0]) {
        translate([0, 0, z0 - 3]) cube([size[0], size[1], 3]);      // underside wiring
        translate([0, 0, z0]) cube([size[0], size[1], 1.6]);        // the board
        for (p = parts) translate([p[0], p[1], z0 + 1.6]) cube([p[2] - p[0], p[3] - p[1], p[4]]);
    }
}
module mega_contents() {
    translate(mega_pos) {
        translate([0, 0, mega_standoff_h - 2]) cube([101.6, 53.3, 2]);
        // Mega + stacking headers + hub shield + box headers + plugs + ribbon bend
        translate([0, 0, mega_standoff_h]) cube([101.6, 53.3, 34]);
        // USB-B jack overhangs the board edge by 6.2 mm
        translate([-6.2, usb_center_y - 6, mega_standoff_h + 1.6]) cube([16, 12, 11]);
    }
}
module gland_contents() {
    for (g = glands) {
        nut = g[1] < 14 ? gland_nut[0][1] : gland_nut[1][1];
        translate([g[2] - wall, 0.01, gland_z]) rotate([-90, 0, 0]) {
            cylinder(h = 9, d = nut);              // thread + locknut
            cylinder(h = 14, d = 8);               // cable on its way to the board
        }
    }
}
// The wires inside the box. Each cable's cores fan from its gland to its
// terminal group, ending in 6 mm of straight wire into the terminals; the two
// ribbons run from their board headers (plug on top) over to the hub on the Mega.
function tgroup(list, name) = list[search([name], list, 1, 0)[0]];
module terminal_entry(pos, t) {
    top = pb_standoff_h + 1.6;
    if (t[2] < 5)   // front row: wires come in from the front
        translate([pos[0] + t[1], pos[1] + t[2] - 6, top + 2]) cube([t[3] - t[1], 5.99, 6]);
    else            // left edge (J3): wires come in from the left
        translate([pos[0] + t[1] - 6, pos[1] + t[2], top + 2]) cube([5.99, t[4] - t[2], 6]);
}
module dot(p) translate(p) sphere(d = bundle_d, $fn = 16);
module gland_fans() {
    for (w = gland_wires) {
        g = glands[search([w[0]], glands, 1, 0)[0]];
        pos = w[1] == "logic" ? logic_pos : power_pos;
        t = tgroup(w[1] == "logic" ? logic_terminals : power_terminals, w[2]);
        start = [g[2] - wall, 14, gland_z];
        if (len(w) > 3) {
            hull() { dot(start); dot([w[3][0], w[3][1], 12]); }
            hull() { dot([w[3][0], w[3][1], 12]); terminal_entry(pos, t); }
        } else {
            hull() { dot(start); terminal_entry(pos, t); }
        }
    }
}
module ribbon_plugs() {
    top = pb_standoff_h + 1.6;
    for (b = [[power_pos, power_terminals, "JA"], [logic_pos, logic_terminals, "JB"]]) {
        t = tgroup(b[1], b[2]);
        translate([b[0][0] + t[1], b[0][1] + t[2], top + t[5] + 0.01]) cube([t[3] - t[1], t[4] - t[2], ribbon_plug_h]);
    }
}
module ribbons() {
    top = pb_standoff_h + 1.6;
    hub_top = mega_standoff_h + 34;
    a = tgroup(power_terminals, "JA");
    b = tgroup(logic_terminals, "JB");
    // A: up out of the plug on the power board, across to the hub's right-hand end
    hull() {
        translate([power_pos[0] + a[1], power_pos[1] + a[2], top + a[5] + ribbon_plug_h]) cube([a[3] - a[1], a[4] - a[2], 2]);
        translate([mega_pos[0] + 70, mega_pos[1] + 15, hub_top - 3]) cube([30, 34, 2]);
    }
    // B: from the logic board's back edge over the gap to the hub's front edge
    hull() {
        translate([logic_pos[0] + b[1], logic_pos[1] + b[2], top + b[5] + ribbon_plug_h]) cube([b[3] - b[1], b[4] - b[2], 2]);
        translate([mega_pos[0] + 15, mega_pos[1], hub_top - 3]) cube([30, 10, 2]);
    }
}
module wiring() { gland_fans(); ribbon_plugs(); ribbons(); }
// Room to work: between the gland nuts (9 mm in from the wall) and the
// boards' front edges there must be at least min_work_gap mm of clear space
// across the whole box, for fingers, a small screwdriver and the wires.
min_work_gap = 15;
work_gap = min(power_pos[1], logic_pos[1]) - 9;
module work_room() { translate([9, 9.01, 0.01]) cube([IW - 18, work_gap - 0.02, IH - 3]); }

module all_contents() {
    board_contents(power_pos, power_board_size, power_parts);
    board_contents(logic_pos, logic_board_size, logic_parts);
    mega_contents();
    gland_contents();
}
module fit_check() {
    // Each line must be EMPTY.
    // (the standoffs are left out here: the boards sit on them by design)
    intersection() { box(false); inside() all_contents(); }
    inside() {
        intersection() { board_contents(power_pos, power_board_size, power_parts); mega_contents(); }
        intersection() { board_contents(logic_pos, logic_board_size, logic_parts); mega_contents(); }
        intersection() { board_contents(power_pos, power_board_size, power_parts);
                         board_contents(logic_pos, logic_board_size, logic_parts); }
        intersection() { gland_contents(); union() {
            board_contents(power_pos, power_board_size, power_parts);
            board_contents(logic_pos, logic_board_size, logic_parts); mega_contents(); } }
        // nothing may reach the lid's locating lip (top 3 mm)
        intersection() { all_contents(); translate([-10, -10, IH - 3]) cube([IW + 20, ID + 20, 10]); }
        // the wires: through the air, not through parts, the lid lip or another gland
        intersection() { wiring(); union() {
            board_contents(power_pos, power_board_size, power_parts);
            board_contents(logic_pos, logic_board_size, logic_parts); } }
        intersection() { wiring(); translate([-10, -10, IH - 3]) cube([IW + 20, ID + 20, 10]); }
        intersection() { gland_fans(); ribbons(); }
        intersection() { work_room(); union() {
            board_contents(power_pos, power_board_size, power_parts);
            board_contents(logic_pos, logic_board_size, logic_parts); mega_contents(); } }
    }
    intersection() { box(false); inside() union() { wiring(); work_room(); } }
    assert(work_gap >= min_work_gap, str("only ", work_gap, " mm to wire the terminals"));
}
module populated() {
    color("gold") box();
    inside() {
        color("darkgreen") board_contents(power_pos, power_board_size, power_parts);
        color("seagreen") board_contents(logic_pos, logic_board_size, logic_parts);
        color("steelblue") mega_contents();
        color("dimgray") gland_contents();
        color("crimson") wiring();
    }
}

// ------------------------------------------------------------ build-book views
// part = "build", bstep = 1..4: the assembly so far, with this step's pieces
// highlighted (orange) and earlier ones grey.
bstep = 4;
module hi(n) { if (bstep == n) color("orangered") children(); else if (bstep > n) color("silver") children(); }
module build_view() {
    color("gold") box();
    // 1: heat-set inserts in the corner bosses
    hi(1) inside() for (c = corner_boss)
        // drawn half out of their holes, as if being pressed in (step 1 only)
        translate([c[0] + (c[0] == 0 ? boss_off : -boss_off), c[1] + (c[1] == 0 ? boss_off : -boss_off),
                   IH - (bstep == 1 ? 1 : 6)])
            cylinder(h = 6.2, d = insert_d + 1.5);
    // 2: glands (dome outside, locknut inside)
    hi(2) for (g = glands) {
        nut = g[1] < 14 ? gland_nut[0][1] : gland_nut[1][1];
        translate([g[2], 0, floor_t + gland_z]) rotate([90, 0, 0]) {
            cylinder(h = 10, d = nut - 3, $fn = 6);
            translate([0, 0, 10]) cylinder(h = 8, d1 = nut - 3, d2 = g[1] - 4);
        }
        translate([g[2], wall, floor_t + gland_z]) rotate([-90, 0, 0]) cylinder(h = 5, d = nut, $fn = 6);
    }
    // 3: Mega + hub, power board, logic board
    hi(3) inside() {
        board_contents(power_pos, power_board_size, power_parts);
        board_contents(logic_pos, logic_board_size, logic_parts);
        mega_contents();
    }
    // 4: the lid, lifted
    hi(4) translate([0, 0, OH + 25]) lid();
}

if (part == "box") box();
// The lid is exported upside down (top face on the bed, lip up) so it prints without supports.
else if (part == "lid") translate([0, OD, lid_t]) rotate([180, 0, 0]) lid();
else if (part == "fit_check") fit_check();
else if (part == "fit") populated();
else if (part == "build") build_view();
else if (part == "assembly") { box(); color("grey", 0.6) translate([0, 0, OH + 10]) lid(); }
